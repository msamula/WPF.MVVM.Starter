{
  "$schema": "http://json.schemastore.org/template",
  "author": "Michael Samula",
  "classifications": [ "WPF", "MVVM", "Template" ],
  "name": "WPF MVVM Starter",
  "identity": "MSamula.WPF.MVVM.Starter",
  "shortName": "wpfmvvmstarter",
  "sourceName": "WPF.MVVM.Starter",

  "symbols": {
    "author": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "Unknown",
      "replaces": "__AUTHOR__",
      "description": "Author name"
    },
    "product": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "MyWpfApp",
      "replaces": "__PRODUCT_NAME__",
      "description": "Product name"
    }
  },

  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            "**/bin/**",
            "**/obj/**",
            "**/.git/**",
            "**/.vs/**",
            "**/*.user",
            ".gitattributes",
            ".gitignore",
            "README.md",
            "LICENSE.txt"
          ]
        }
      ]
    }
  ]
}
